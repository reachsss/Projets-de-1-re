function doPost(e) {
  try {
    var params = e.parameter;
    var nom = params.Nom;
    var email = params.Email;
    var date = params.Date;
    var time = params.Heure;
    var service = params.Service;
    var message = params.Message;

    var durees = {
      "Pose complète rallongement": 90,
      "Pose complète ongle naturel": 60,
      "Semi-permanent mains": 45,
      "Semi-permanent pieds": 45,
      "Remplissage": 40,
      "Dépose gel": 30,
      "Dépose semi-permanent": 20
    };

    var dureeMinutes = durees[service] || 30;

    var ss = SpreadsheetApp.openById("1JlckQKpvVnlhCBUL9uZf6LN3rYCyt4u2YBRpkd_mvck");
    var sheet = ss.getSheetByName("RDV Ongles");
    sheet.appendRow([nom, email, date, time, service, message]);

    Logger.log("Date/Heure: " + date + "T" + time + ":00");

    var calendar = CalendarApp.getCalendarById("lesongles2camille@gmail.com");
    var startDateTime = new Date(date + "T" + time + ":00");
    var endDateTime = new Date(startDateTime.getTime() + dureeMinutes * 60000);

    calendar.createEvent(
      "RDV: " + service + " avec " + nom,
      startDateTime,
      endDateTime,
      { description: message + "\nEmail: " + email }
    );

    return HtmlService.createHtmlOutputFromFile('merci');

  } catch (error) {
    return ContentService.createTextOutput('Erreur: ' + error.message);
  }
}


